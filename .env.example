AIDA_ENVIRONMENT=development
AIDA_LOG_LEVEL=INFO
AIDA_DATABASE_URL=postgresql+asyncpg://aida:aida-local-only@localhost:5432/aida
AIDA_TEMPORAL_ADDRESS=localhost:7233
AIDA_TEMPORAL_NAMESPACE=default
AIDA_TEMPORAL_TASK_QUEUE=aida-metadata
AIDA_REDIS_URL=redis://localhost:6379/0
AIDA_NEO4J_URI=bolt://localhost:7687
AIDA_NEO4J_USER=neo4j
AIDA_NEO4J_PASSWORD=aida-local-only
AIDA_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
AIDA_OBJECT_STORE_ENDPOINT=http://localhost:9000
AIDA_OBJECT_STORE_ACCESS_KEY=aida
AIDA_OBJECT_STORE_SECRET_KEY=aida-local-only
AIDA_AUDIT_HMAC_KEY=local-development-audit-hmac-key-only
AIDA_IDENTITY_PROVIDER=development
AIDA_CREDENTIAL_PROVIDER=env
AIDA_SECRET_CACHE_TTL_SECONDS=60
# Production requires OIDC issuer, audience, and an HTTPS JWKS URL (or pinned JWKS JSON).
# AIDA_OIDC_ISSUER=https://identity.bank.example
# AIDA_OIDC_AUDIENCE=atlas-api
# AIDA_OIDC_JWKS_URL=https://identity.bank.example/.well-known/jwks.json
# AIDA_OIDC_ROLE_MAPPINGS={"BANK_ANALYST":["Analyst","Viewer"]}
# Register the selected Vault/CyberArk/cloud secret adapter in the deployment composition root.
AIDA_AGENT_RETRIEVAL_LIMIT=25
AIDA_AGENT_RETRIEVAL_SCAN_LIMIT=5000
AIDA_AGENT_TOOL_MATCH_THRESHOLD=0.55
AIDA_LINEAGE_CACHE_ENABLED=false
AIDA_LINEAGE_CACHE_TTL_SECONDS=30
AIDA_LINEAGE_PROJECTION_MAX_NODES=20000
AIDA_LINEAGE_PROJECTION_MAX_EDGES=100000
AIDA_LINEAGE_NEO4J_READ_ENABLED=false
AIDA_MCP_BUDGET_ENABLED=false
AIDA_MCP_REQUESTS_PER_MINUTE=120
AIDA_MCP_TOOL_CALLS_PER_DAY=1000
AIDA_MCP_CONTEXT_READS_PER_DAY=5000
AIDA_MCP_REQUIRE_WORKLOAD_IDENTITY=true
AIDA_OIDC_BUSINESS_PURPOSE_CLAIM=business_purpose
AIDA_ENTITLEMENT_PROVIDER=outbox
AIDA_ENTITLEMENT_WEBHOOK_URL=
AIDA_ENTITLEMENT_WEBHOOK_TOKEN=
AIDA_MODEL_GENERATION_ENABLED=false
AIDA_MODEL_ROUTE=openai-bank-sql
# An approved route registry entry does not activate generation; selection and a
# registered provider adapter are separate production controls.
# Optional comma-separated list of ADDITIONAL approved route_keys to try in
# preference order when the primary route above fails with a transient provider
# error (HTTP 429/502/503/504) after its own in-route retries are exhausted.
# Each entry must itself be an APPROVED ModelRouteConfiguration -- unapproved
# entries are silently skipped, not errors. Non-transient errors (401/403 auth,
# 400 malformed) do NOT trigger fallback: they signal a broken route, not a
# busy provider.
AIDA_MODEL_ROUTE_FALLBACKS=
AIDA_MODEL_TIMEOUT_SECONDS=30
AIDA_MODEL_MAX_INPUT_TOKENS=8000
AIDA_MODEL_MAX_OUTPUT_TOKENS=2000
AIDA_OPENAI_BASE_URL=https://api.openai.com/v1
AIDA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AIDA_MODEL_PROVIDER_MAX_ATTEMPTS=3
AIDA_SAMPLE_SOURCE_DSN=postgresql://source:source-local-only@localhost:55432/bank_demo
AIDA_SAMPLE_RISK_SOURCE_DSN=postgresql://source:source-local-only@localhost:55432/risk_demo
AIDA_SAMPLE_MSSQL_SOURCE_DSN=mssql://source:S0urce!LocalOnly1@localhost:14330/bank_demo_mssql
OPENAI_API_KEY=replace-with-local-openai-key
GEMINI_API_KEY=replace-with-local-gemini-key

# --- Audit archive (WORM) -----------------------------------------------
# `none` is the default and resolves to a provider that REFUSES rather than
# reporting success, so a deployment that has not named a destination records
# a retryable failure instead of manufacturing archive evidence it does not
# have (review-2026-09-05 F01). Two fully implemented providers:
# `filesystem` and `s3`; `gcs`/`azure_blob` parse but resolve to an
# explicitly unavailable provider — no client for either is a dependency of
# this project, and they are deliberately not faked to match `s3`.
#
# `filesystem`: point the root at a volume with a real WORM/retention
# policy. The provider's own immutability is a guard rail, not a security
# boundary — it is a mode bit this process could itself clear.
#
# `s3`: S3 Object Lock, where the immutability is the service's refusal.
# Reads AIDA_OBJECT_STORE_ENDPOINT / ACCESS_KEY / SECRET_KEY above, plus the
# bucket and region below. COMPLIANCE retention cannot be bypassed or
# shortened by anyone, including the account root; GOVERNANCE can be waived
# by any principal holding s3:BypassGovernanceRetention, so it is only for a
# deployment that has consciously chosen a weaker guarantee. Object Lock can
# only be enabled when a bucket is created, which is why the worker may
# create one (set _CREATE_BUCKET=false if buckets are provisioned elsewhere
# — then provision it with Object Lock enabled).
AIDA_AUDIT_ARCHIVE_STORAGE_BACKEND=none
AIDA_AUDIT_ARCHIVE_FILESYSTEM_ROOT=
AIDA_AUDIT_ARCHIVE_BUCKET_NAME=audit-archive
AIDA_AUDIT_ARCHIVE_S3_REGION=us-east-1
AIDA_AUDIT_ARCHIVE_S3_RETENTION_MODE=COMPLIANCE
AIDA_AUDIT_ARCHIVE_S3_CREATE_BUCKET=true
AIDA_AUDIT_ARCHIVE_LEASE_SECONDS=900
AIDA_AUDIT_ARCHIVE_LATE_ARRIVAL_OVERLAP_SECONDS=86400

# --- Security event delivery (SIEM) and durable delivery worker ----------
# `internal://security-log-pipeline` names no destination — it is the label
# this platform shipped when "routing" was a local log line. It resolves to
# NOT_CONFIGURED, so `AIDA_SIEM_ENABLED=true` queues and sends nothing until
# a real collector is named here. Point it at `https://…` for webhook, or
# `syslog://host:514` / `syslog+tcp://host:601` for syslog (RFC 5424; TCP
# uses RFC 6587 octet counting).
AIDA_SIEM_ENABLED=true
AIDA_SIEM_TRANSPORT=webhook
AIDA_SIEM_ENDPOINT=internal://security-log-pipeline
# When false, event details are omitted from the STORED payload, so every
# transport rendered from it suppresses them — not remembered twice.
AIDA_SIEM_INCLUDE_DETAILS=true
AIDA_SIEM_DELIVERY_TIMEOUT_SECONDS=5.0
# The single switch that lets anything leave this deployment. Off by default
# so an upgrade cannot start sending traffic to a destination by surprise.
AIDA_DELIVERY_WORKER_ENABLED=false
AIDA_DELIVERY_WORKER_BATCH_SIZE=100
AIDA_DELIVERY_MAX_ATTEMPTS=6
AIDA_DELIVERY_BACKOFF_BASE_SECONDS=5.0
AIDA_DELIVERY_BACKOFF_MAX_SECONDS=900.0
AIDA_DELIVERY_CLAIM_SECONDS=300
AIDA_DELIVERY_WEBHOOK_VERIFY_TLS=true

# --- Authorization posture and readiness ---------------------------------
# OBSERVING (the default, deliberately unchanged) means workspace decisions
# are logged and NOT enforced: successful configuration validation is not
# proof of enforcement (review-2026-09-05 F11). ENFORCING is a claim the
# platform checks — Settings refuses to construct if it is set while
# unresolved scope is still allowed through, and startup fails if any ACTIVE
# workspace is not in ENFORCE. `/health/ready` reports which is true.
AIDA_WORKSPACE_AUTHORIZATION_POSTURE=OBSERVING
AIDA_UNRESOLVED_WORKSPACE_POSTURE=SHADOW
# Bounds the readiness endpoint as a whole; probes run concurrently.
AIDA_READINESS_PROBE_TIMEOUT_SECONDS=2.0

# --- Principal lifecycle reconciliation ----------------------------------
# Replays identity.principal.deleted/merged events so a departed owner's
# ACTIVE ownership rows are lapsed and their subjects re-routed. Off by
# default: enabling it starts mutating ownership in an existing estate.
AIDA_PRINCIPAL_RECONCILIATION_ENABLED=false
AIDA_PRINCIPAL_RECONCILIATION_INTERVAL_SECONDS=3600
AIDA_PRINCIPAL_RECONCILIATION_LOOKBACK_SECONDS=86400
AIDA_PRINCIPAL_RECONCILIATION_BATCH_SIZE=200
