FROM node:22-alpine

WORKDIR /app

# The source tree is bind-mounted by compose.dev.yaml. Dependencies live in a
# named volume so host-specific node_modules never leak into the Linux image.
COPY package.json package-lock.json ./

EXPOSE 3000

CMD ["sh", "-c", "npm ci && npm run dev -- --host 0.0.0.0 --port 3000"]
